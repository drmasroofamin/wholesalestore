# Default demonstration; no real orders are accepted.
DEMO_MODE=true
# Set true only for controlled end-to-end verification / your reviewed launch.
ACCEPT_ORDERS=false
APP_ORIGIN=http://localhost:3000
STORE_NAME=
STORE_PHONE=
# Shown on the contact page and footer only when set. No placeholder is invented.
STORE_EMAIL=
STORE_ADDRESS=
STORE_DISTRICT=Anantnag district
# Optional merchant-reviewed policy text, displayed on /policies.
CANCELLATION_POLICY=
REFUND_POLICY=
# Managed PostgreSQL for deployment; the values below are LOCAL development only.
DATABASE_URL=postgresql://grain:grain_local_only@localhost:5432/grain
# Optional direct, non-pooled connection for migrations, not web requests.
DIRECT_DATABASE_URL=
DATABASE_POOL_MAX=2
REDIS_URL=redis://localhost:6379
# Generate locally using npm run admin:password. Never use a plaintext password here.
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Keep all of these values server-only.
SESSION_SECRET=
CRON_SECRET=
# Test keys are labelled; test-payment orders cannot be fulfilled as paid orders.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Only set for an isolated integration-test database whose name contains test.
TEST_DATABASE_URL=
# Customer phone login: enable only after configuring and testing real SMS below.
# Until enabled, existing guest checkout continues to work.
CUSTOMER_ACCOUNTS_ENABLED=false
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
